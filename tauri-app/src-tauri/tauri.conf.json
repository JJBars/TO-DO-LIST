{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayly",
  "version": "0.1.0",
  "identifier": "com.benja.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dayly",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCREMwMUQzRDBGMDQ1MkYKUldRdlJmRFEwd0hjbTZsaUNja1daRlJhNGY4dW1SeGRMU2tyMGlXSGhnVVJpaFkzYXRabktHWG4K",
      "endpoints": [
        "https://github.com/JJBars/TO-DO-LIST/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
